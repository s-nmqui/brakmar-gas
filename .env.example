# Copiá este archivo a .env.local y completá los valores.

# Nombre de usuario y contraseña del administrador inicial.
# La cuenta se crea automáticamente la primera vez (mínimo 10 caracteres).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena-123

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# EN PRODUCCIÓN ES OBLIGATORIO. Generalo, por ejemplo, con:
#   openssl rand -hex 32
SESSION_SECRET=

# URL pública del sitio (usada en sitemap, robots y metadatos).
# Ejemplos:
#   NEXT_PUBLIC_SITE_URL=https://brakmar-gas.vercel.app
#   NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=

# Ruta de la base de datos SQLite (opcional; por defecto ./data/brakmar.db)
# DATABASE_PATH=